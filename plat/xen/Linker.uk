ifeq (x86_64,$(CONFIG_UK_ARCH))
ifneq ($(CONFIG_PARTIAL_LINKER_TYPE),raw)
XEN_LDFLAGS-y += -Wl,-m,elf_x86_64
endif
else ifeq (arm64,$(CONFIG_UK_ARCH))
ifneq ($(CONFIG_PARTIAL_LINKER_TYPE),raw)
XEN_LDFLAGS-y += -Wl,-m,aarch64elf
endif
XEN_LDLIBS-y += -lgcc
endif

##
## Link image
##
ifneq ($(UK_IMAGE_NAME_OVERWRITE),)
XEN_RAW_IMAGE   := $(BUILD_DIR)/$(UK_IMAGE_NAME_OVERWRITE)
else
XEN_RAW_IMAGE   := $(BUILD_DIR)/$(CONFIG_UK_NAME)_xen-$(CONFIG_UK_ARCH)
endif
ifeq (arm,$(CONFIG_UK_ARCH))
XEN_IMAGE       := $(XEN_RAW_IMAGE).elf
else ifeq (arm64,$(CONFIG_UK_ARCH))
XEN_RAW_IMAGE   := $(BUILD_DIR)/$(CONFIG_UK_NAME)_xen-$(CONFIG_UK_ARCH)
XEN_IMAGE       := $(XEN_RAW_IMAGE).elf
else
XEN_IMAGE       := $(XEN_RAW_IMAGE)
endif
XEN_DEBUG_IMAGE := $(XEN_IMAGE).dbg
XEN_COMPILE_DB_IMAGE := $(BUILD_DIR)/compile_commands.json

XEN_LD_SCRIPT_INPUTS := $(UK_PLAT_XEN_DEF_LDS) \
			$(XEN_LD_SCRIPT-y) $(EXTRA_LD_SCRIPT-y)

# Some compiler drivers that need a raw partial linker retain only the last
# -T option. Merge supplemental INSERT scripts into the platform script.
ifeq ($(CONFIG_PARTIAL_LINKER_TYPE),raw)
XEN_COMBINED_LD_SCRIPT := $(BUILD_DIR)/xen-combined.lds
XEN_LD_SCRIPT_MERGER := $(CONFIG_UK_BASE)/support/build/merge-linker-scripts.py

$(XEN_COMBINED_LD_SCRIPT): $(XEN_LD_SCRIPT_INPUTS) $(XEN_LD_SCRIPT_MERGER)
	$(call build_cmd,GEN,,$@,\
		$(PYTHON) $(XEN_LD_SCRIPT_MERGER) \
			$(XEN_COMBINED_LD_SCRIPT) $(XEN_LD_SCRIPT_INPUTS))

XEN_LD_SCRIPT_FLAGS := -Wl$(comma)-T$(comma)$(XEN_COMBINED_LD_SCRIPT)
XEN_LD_SCRIPT_DEPS := $(XEN_COMBINED_LD_SCRIPT)
else
XEN_LD_SCRIPT_FLAGS := $(addprefix -Wl$(comma)-dT$(comma),\
			 $(UK_PLAT_XEN_DEF_LDS))
XEN_LD_SCRIPT_FLAGS += $(addprefix -Wl$(comma)-T$(comma),\
			 $(XEN_LD_SCRIPT-y) $(EXTRA_LD_SCRIPT-y))
XEN_LD_SCRIPT_DEPS := $(XEN_LD_SCRIPT_INPUTS)
endif

$(eval $(call add_build_graph_link_stage,xen,partial-link,partial-link,\
	$(XEN_IMAGE).ld.o))
$(eval $(call add_build_graph_link_inputs,xen,partial-link,object,\
	$(XEN_OLIBS) $(XEN_OLIBS-y) $(UK_OLIBS) $(UK_OLIBS-y)))
$(eval $(call add_build_graph_link_inputs,xen,partial-link,archive,\
	$(XEN_ALIBS) $(XEN_ALIBS-y) $(UK_ALIBS) $(UK_ALIBS-y)))
$(eval $(call add_build_graph_link_stage,xen,localize,objcopy-localize,\
	$(XEN_IMAGE).o))
$(eval $(call add_build_graph_link_inputs,xen,localize,intermediate,\
	$(XEN_IMAGE).ld.o))
$(eval $(call add_build_graph_link_stage,xen,final-link,link,\
	$(XEN_DEBUG_IMAGE)))
$(eval $(call add_build_graph_link_inputs,xen,final-link,linker-script,\
	$(XEN_LD_SCRIPT_DEPS)))
$(eval $(call add_build_graph_link_inputs,xen,final-link,intermediate,\
	$(XEN_IMAGE).o))

$(XEN_DEBUG_IMAGE): $(XEN_ALIBS) $(XEN_ALIBS-y) $(XEN_OLIBS) $(XEN_OLIBS-y) \
		    $(UK_ALIBS) $(UK_ALIBS-y) $(UK_OLIBS) $(UK_OLIBS-y) \
		    $(XEN_LD_SCRIPT_DEPS) $(UK_LDEPS)
	$(call build_cmd,LD,,$(XEN_IMAGE).ld.o,\
	       $(PARTIAL_LD) $(call partial_linker_flags,\
			-r $(LIBLDFLAGS) $(LIBLDFLAGS-y) \
			$(XEN_LDFLAGS) $(XEN_LDFLAGS-y)) \
			$(XEN_OLIBS) $(XEN_OLIBS-y) \
			$(UK_OLIBS) $(UK_OLIBS-y) \
			$(call partial_linker_flags,-Wl$(comma)--start-group) \
			$(XEN_ALIBS) $(XEN_ALIBS-y) \
			$(UK_ALIBS) $(UK_ALIBS-y) \
			$(call partial_linker_flags,-Wl$(comma)--end-group) \
			$(XEN_LDLIBS) $(XEN_LDLIBS-y) \
			-o $(XEN_IMAGE).ld.o)
	$(call build_cmd,OBJCOPY,,$(XEN_IMAGE).o,\
		$(OBJCOPY) -w -G xenos_* -G _libxenplat_zimageboot -G _libxenplat_start \
			$(XEN_IMAGE).ld.o $(XEN_IMAGE).o)
	$(call build_cmd,LD,,$@,\
	       $(LD) $(LDFLAGS) $(LDFLAGS-y) $(XEN_LDFLAGS) $(XEN_LDFLAGS-y) \
		     $(XEN_LD_SCRIPT_FLAGS) \
		     $(XEN_IMAGE).o -o $@)
ifeq ($(CONFIG_OPTIMIZE_PIE),y)
	$(call build_uk_reloc,$@)
endif
ifeq ($(CONFIG_LIBUKPCPUVAR),y)
	$(call build_uk_pcpuvar,$@)
endif

$(XEN_IMAGE): $(XEN_DEBUG_IMAGE)
	$(call build_cmd,SCSTRIP,,$@,\
		$(STRIP) -s \
			$(SECT_STRIP_FLAGS) $(SECT_STRIP_FLAGS-y) \
			$< -o $@ 2>&1 | \
		        { $(GREP) -Ev \
				"Empty loadable segment detected|section.*lma.*adjusted to.*" || \
				true; })
	$(call build_bootinfo,$@)

ifeq (arm,$(CONFIG_UK_ARCH))
$(XEN_RAW_IMAGE): $(XEN_IMAGE)
	$(call build_cmd,OBJCOPY,,$@,$(OBJCOPY) -O binary $< $@)
else ifeq (arm64,$(CONFIG_UK_ARCH))
$(XEN_RAW_IMAGE): $(XEN_IMAGE)
	$(call build_cmd,OBJCOPY,,$@,$(OBJCOPY) -O binary $< $@)
endif

$(XEN_IMAGE).sym: $(XEN_DEBUG_IMAGE)
	$(call build_cmd,NM,,$@, $(NM) -n $< > $@)

ifeq (arm,$(CONFIG_UK_ARCH))
$(XEN_RAW_IMAGE).gz: $(XEN_RAW_IMAGE)
	$(call build_cmd,GZ,,$@, $(GZIP) -f -9 -c $< >$@)
else ifeq (arm64,$(CONFIG_UK_ARCH))
$(XEN_RAW_IMAGE).gz: $(XEN_RAW_IMAGE)
	$(call build_cmd,GZ,,$@, $(GZIP) -f -9 -c $< >$@)
else
$(XEN_IMAGE).gz: $(XEN_IMAGE)
	$(call build_cmd,GZ,,$@, $(GZIP) -f -9 -c $< >$@)

endif

$(XEN_COMPILE_DB_IMAGE): $(XEN_IMAGE)
	$(call build_compile_db,$(BUILD_DIR),$@)

# register images to the build
ifeq ($(CONFIG_PLAT_XEN),y)
UK_DEBUG_IMAGES-y                     += $(XEN_DEBUG_IMAGE)
UK_IMAGES-y                           += $(XEN_IMAGE)
UK_IMAGES-$(CONFIG_OPTIMIZE_SYMFILE)  += $(XEN_IMAGE).sym

ifeq (arm,$(CONFIG_UK_ARCH))
UK_IMAGES-y                           += $(XEN_RAW_IMAGE)
UK_IMAGES-$(CONFIG_OPTIMIZE_COMPRESS) += $(XEN_RAW_IMAGE).gz
else ifeq (arm64,$(CONFIG_UK_ARCH))
UK_IMAGES-y                           += $(XEN_RAW_IMAGE)
UK_IMAGES-$(CONFIG_OPTIMIZE_COMPRESS) += $(XEN_RAW_IMAGE).gz
else
UK_IMAGES-$(CONFIG_OPTIMIZE_COMPRESS) += $(XEN_IMAGE).gz
endif
UK_IMAGES-y                           += $(XEN_COMPILE_DB_IMAGE)
endif

# register image to the build
UK_IMAGES-$(CONFIG_PLAT_XEN) += $(XEN_IMAGE)

# ...for cleaning:
LIBXENPLAT_CLEAN += $(call build_clean,$(XEN_IMAGE).ld.o)
LIBXENPLAT_CLEAN += $(call build_clean,$(XEN_IMAGE).o)
LIBXENPLAT_CLEAN += $(call build_clean,$(XEN_IMAGE).elf)
LIBXENPLAT_CLEAN += $(call build_clean,$(XEN_COMBINED_LD_SCRIPT))
