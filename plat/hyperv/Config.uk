menuconfig PLAT_HYPERV
	bool "Hyper-V Generation 2 guest"
	default n
	depends on ARCH_X86_64
	depends on UKPLAT_CPU_MAXCOUNT = 1
	select OPTIMIZE_PIE
	select LIBUKDEBUG
	select LIBUKBOOT
	select LIBUKBITOPS
	select LIBUKALLOC
	select LIBUKTIMECONV
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKATOMIC
	select LIBUKACPI
	select LIBUKEFI
	select LIBUKPAGING
	select HAVE_PAGING
	select LIBUKPLAT_NATIVE_PAL
	select LIBUKPLAT_NATIVE_PAGING
	select LIBUKPLAT_NATIVE_LCPU_PM if LIBUKLCPU
	select HAVE_INTCTLR
	select HAVE_APIC
	select HAVE_IBMPC_NS16550
	select LIBUKINTCTLR_XPIC
	select LIBUKINTCTLR_APIC
	imply LIBNS16550 if LIBUKCONSOLE
	imply LIBNS16550_EARLY_CONSOLE if LIBUKCONSOLE
	imply LIBNS16550_COM1 if LIBUKCONSOLE
	imply LIBUKRANDOM_LCPU if LIBUKRANDOM
	help
		Create an x86_64 UEFI image for Hyper-V Generation 2 guests.
		SynIC MSRs and pages are per-vCPU; SMP remains disabled until
		per-vCPU Hyper-V startup is implemented.

if PLAT_HYPERV

config HYPERV_EFI_STUB_CMDLINE_FNAME
	string "Name of the command line arguments file"
	default ""

config HYPERV_EFI_STUB_INITRD_FNAME
	string "Name of the initial RAM disk file"
	default ""

config HYPERV_EFI_STUB_DTB_FNAME
	string "Name of the Devicetree Blob file"
	default ""

config HYPERV_EFI_STUB_RST_ATK_MITIGATION
	bool "TCG Reset Attack Mitigation"
	default n
	help
		Request firmware memory overwrite on the next reset.

endif
