config LIBSTORVSC
	bool "Hyper-V StorVSC synthetic block device"
	depends on LIBVMBUS
	depends on LIBUKBLKDEV
	select LIBUKSCHED
	default n
	help
		Expose Hyper-V synthetic SCSI disks through ukblkdev. Defaults
		preserve one primary controller, LUN 0, and one request queue;
		bounded controller and LUN pools can be enabled explicitly.

if LIBSTORVSC

config LIBSTORVSC_MAX_DEVICES
	int "Maximum StorVSC controllers"
	range 1 8
	default 1
	help
		Maximum synthetic storage-controller identities retained for the
		boot. Successfully bound identities are not recycled after
		removal. Raising this intentionally enables multi-controller
		binding.

config LIBSTORVSC_LUN_DISCOVERY
	bool "Enable REPORT LUNS discovery"
	default n
	help
		Issue bounded SCSI REPORT LUNS and VPD page 0x83 commands, then
		attach supported reported LUNs independently. Disabled preserves
		the legacy LUN 0 path without issuing discovery commands. A
		successful stable zero-entry report may bind an empty controller;
		failed addressed discovery never proves emptiness.

config LIBSTORVSC_GUARDED_IO
	bool "Require an authorized StorVSC session for I/O"
	depends on LIBSTORVSC_LUN_DISCOVERY
	default n
	help
		Require a current read session for reads and an explicitly
		authorized write session for writes and cache flushes. Sessions
		are invalidated by reset, removal, or rebind. This destructive
		acceptance guard is intentionally disabled for ordinary builds.

config LIBSTORVSC_MAX_LUNS
	int "Maximum LUNs per StorVSC controller"
	range 1 64
	default 1
	help
		Maximum LUN identities retained per controller for the boot.
		Registered block-device identities are not recycled after LUN
		or controller removal. Values above one require
		LIBSTORVSC_LUN_DISCOVERY.

config LIBSTORVSC_MAX_QUEUES
	int "Maximum queues per StorVSC device"
	range 1 1
	default 1
	help
		StorVSC currently supports exactly one primary-channel queue.

config LIBSTORVSC_QUEUE_DEPTH
	int "StorVSC request-context pool size"
	range 1 64
	default 32

config LIBSTORVSC_MAX_TRANSFER_PAGES
	int "Maximum GPA-direct pages per request"
	range 2 64
	default 33
	help
		Includes a possible partial first page. The advertised transfer
		limit is conservatively one page smaller so any aligned ukblkdev
		buffer offset remains representable.

config LIBSTORVSC_TX_RING_PAGES
	int "StorVSC transmit ring pages"
	range 2 32
	default 16
	help
		Includes the one-page VMBus ring header.

config LIBSTORVSC_RX_RING_PAGES
	int "StorVSC receive ring pages"
	range 2 32
	default 16
	help
		Includes the one-page VMBus ring header.

config LIBSTORVSC_CONTROL_TIMEOUT_MS
	int "VMStor initialization/reset timeout (milliseconds)"
	range 10 30000
	default 1000

config LIBSTORVSC_REQUEST_TIMEOUT_MS
	int "SCSI request timeout (milliseconds)"
	range 100 120000
	default 30000

endif
