CONFIG_ARCH_X86_64=y
# CONFIG_ARCH_ARM_64 is not set
# CONFIG_ARCH_ARM_32 is not set
CONFIG_PLAT_KVM=y
CONFIG_KVM_BOOT_PROTO_MULTIBOOT=y
CONFIG_HAVE_BOOTENTRY=y
CONFIG_UK_NAME="native-x86"
CONFIG_FIXTURE_STRING="quote \" and slash \\"
CONFIG_FIXTURE_INT=-42
CONFIG_FIXTURE_HEX=0x2a
CONFIG_UNKNOWN_FUTURE_SYMBOL=7
