$(eval $(call addlib_s,libgraphfixture,$(CONFIG_LIBGRAPHFIXTURE)))

LIBGRAPHFIXTURE_SRCS-y += $(LIBGRAPHFIXTURE_BASE)/main.c|isr|default
LIBGRAPHFIXTURE_SRCS-y += $(LIBGRAPHFIXTURE_BASE)/generated.awk>.h
LIBGRAPHFIXTURE_GENERATED_AWKINCLUDES-y += \
	$(LIBGRAPHFIXTURE_BASE)/generated-input.txt

LIBGRAPHFIXTURE_ALIBS-y += $(LIBGRAPHFIXTURE_BASE)/fixture-lib.a
EACHOLIB_ALIBS-y += $(LIBGRAPHFIXTURE_BASE)/fixture-each.a
KVM_ALIBS-y += $(LIBGRAPHFIXTURE_BASE)/fixture-platform.a
XEN_ALIBS-y += $(LIBGRAPHFIXTURE_BASE)/fixture-platform.a
UK_ALIBS-y += $(LIBGRAPHFIXTURE_BASE)/fixture-final.a
