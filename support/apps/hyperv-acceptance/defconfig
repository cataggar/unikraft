CONFIG_ARCH_X86_64=y
CONFIG_PLAT_HYPERV=y
CONFIG_UKPLAT_CPU_MAXCOUNT=1
CONFIG_UKPLAT_MEMREGION_MAX_COUNT=512
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_LIBUKDEBUG_PRINTD=n
CONFIG_APPHYPERVACCEPTANCE=y
CONFIG_LIBVMBUS=y
CONFIG_LIBUKBLKDEV=y
CONFIG_LIBSTORVSC=y
# Direct Gen2: retain both OS and data-controller identities, including empty.
CONFIG_LIBSTORVSC_MAX_DEVICES=2
CONFIG_LIBSTORVSC_LUN_DISCOVERY=y
# One OS disk and one disposable data disk; LUN number is not a pool index.
CONFIG_LIBSTORVSC_MAX_LUNS=2
CONFIG_LIBSTORVSC_REQUEST_TIMEOUT_MS=5000
CONFIG_LIBUKSGLIST=y
CONFIG_LIBUKNETDEV=y
CONFIG_LIBNETVSC=y
