menuconfig APPHYPERVACCEPTANCE
	bool "Hyper-V hardware acceptance probe"
	default y
	depends on PLAT_HYPERV
	select LIBNOLIBC
	select LIBUKALLOC
	select LIBUKSCHED
	select LIBUKSCHEDCOOP
	select LIBVMBUS
	select LIBUKBLKDEV
	select LIBSTORVSC
	select LIBUKNETDEV
	select LIBNETVSC
	help
	  Probe real Hyper-V StorVSC and NetVSC I/O without modifying storage.

if APPHYPERVACCEPTANCE

config APPHYPERVACCEPTANCE_NETWORK_APPLICATION
	bool "Run stack-backed private-peer networking acceptance"
	depends on LIBLWIP && LWIP_NOTHREADS && LWIP_DHCP && LWIP_TCP && LWIP_UDP
	depends on LWIP_RELEASE212 && LWIP_UKNETDEV && !LWIP_AUTOIFACE
	help
	  Replace the default raw DHCP Offer smoke with bounded DHCP lease,
	  ARP, TCP, and UDP acceptance through the official lib-lwip stack.

config APPHYPERVACCEPTANCE_PEER_IPV4
	string "Private peer IPv4 address"
	default "10.87.0.4"
	depends on APPHYPERVACCEPTANCE_NETWORK_APPLICATION

config APPHYPERVACCEPTANCE_PEER_TCP_PORT
	int "Private peer TCP port"
	range 1 65535
	default 18887
	depends on APPHYPERVACCEPTANCE_NETWORK_APPLICATION

config APPHYPERVACCEPTANCE_PEER_UDP_PORT
	int "Private peer UDP port"
	range 1 65535
	default 18888
	depends on APPHYPERVACCEPTANCE_NETWORK_APPLICATION

config APPHYPERVACCEPTANCE_NONCE
	string "Acceptance nonce (16 hexadecimal digits)"
	default "87c0ffee5aa8dfd6"
	depends on APPHYPERVACCEPTANCE_NETWORK_APPLICATION
	help
	  Run-manifest nonce encoded as exactly 16 hexadecimal digits without
	  a 0x prefix. Invalid values fail before any network traffic.

config APPHYPERVACCEPTANCE_PERSISTENCE
	bool "Run destructive disposable-disk persistence acceptance"
	default n
	select LIBSTORVSC_LUN_DISCOVERY
	select LIBSTORVSC_GUARDED_IO
	help
	  Replace the ordinary read-only storage/network probe with the
	  manifest-gated two-boot persistence workload. This may write only
	  the uniquely matched disposable disk described below.

if APPHYPERVACCEPTANCE_PERSISTENCE

config APPHYPERVACCEPTANCE_PERSISTENCE_RUN_ID
	string "Private 128-bit run ID (32 lowercase hex digits)"
	default ""

config APPHYPERVACCEPTANCE_PERSISTENCE_DISK_ID
	string "Private 128-bit disk ID (32 lowercase hex digits)"
	default ""

config APPHYPERVACCEPTANCE_PERSISTENCE_SECTORS
	int "Exact disposable disk sector count"
	default 0

config APPHYPERVACCEPTANCE_PERSISTENCE_SECTOR_SIZE
	int "Exact disposable disk sector size"
	default 512

config APPHYPERVACCEPTANCE_PERSISTENCE_PATH
	int "Expected StorVSC path"
	range 0 255
	default 0

config APPHYPERVACCEPTANCE_PERSISTENCE_TARGET
	int "Expected StorVSC target"
	range 0 255
	default 0

config APPHYPERVACCEPTANCE_PERSISTENCE_LUN
	int "Expected StorVSC LUN"
	range 0 255
	default 0
endif
endif

endif
