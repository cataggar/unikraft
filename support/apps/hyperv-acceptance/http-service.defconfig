CONFIG_UK_NAME="helloworld"
CONFIG_UK_DEFNAME="helloworld"
CONFIG_ARCH_X86_64=y
CONFIG_PLAT_HYPERV=y
CONFIG_HYPERV_WAIT_MAX_SPINS=50000000
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_NETVSC=y
CONFIG_LIBUKDEBUG=y
CONFIG_LIBUKDEBUG_PRINTK=y
CONFIG_LIBUKDEBUG_PRINTK_INFO=y
CONFIG_LIBUKDEBUG_ENABLE_ASSERT=y
CONFIG_LIBUKBOOT=y
CONFIG_LIBUKBOOT_BANNER_NONE=y
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKBOOT_INITBBUDDY=y
CONFIG_LIBUKBOOT_INITSCHEDCOOP=y
CONFIG_LIBUKALLOC=y
CONFIG_LIBUKALLOC_IFSTATS=y
CONFIG_LIBUKALLOCBBUDDY=y
CONFIG_LIBUKSCHED=y
CONFIG_LIBUKSCHEDCOOP=y
CONFIG_LIBUKMPI=y
CONFIG_LIBUKLOCK=y
CONFIG_LIBUKLOCK_SEMAPHORE=y
CONFIG_LIBUKLOCK_MUTEX=y
CONFIG_LIBUKTIMECONV=y
CONFIG_LIBNOLIBC=y
CONFIG_LIBUKNETDEV=y
CONFIG_LIBUKNETDEV_MAXNBQUEUES=1
CONFIG_LIBUKSGLIST=y
CONFIG_LIBUKRANDOM=y
# CONFIG_LIBUKRANDOM_LCPU is not set
CONFIG_LIBUKRANDOM_SW=y
CONFIG_LIBUKRANDOM_DEVFS=n
CONFIG_LIBUKSTREAMBUF=y
CONFIG_LIBLWIP=y
CONFIG_LWIP_RELEASE212=y
CONFIG_LWIP_UKNETDEV=y
# CONFIG_LWIP_AUTOIFACE is not set
CONFIG_LWIP_UKNETDEV_POLLONLY=y
CONFIG_LWIP_UKNETDEV_SCRATCH=64
CONFIG_LWIP_NOTHREADS=y
CONFIG_LWIP_HEAP=y
CONFIG_LWIP_NETBUF_RECVINFO=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_UDP=y
CONFIG_LWIP_TCP=y
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_KEEPALIVE=y
CONFIG_LWIP_TCP_TIMESTAMPS=n
CONFIG_LWIP_NUM_TCPCON=64
CONFIG_LWIP_NUM_TCPLISTENERS=4
CONFIG_LWIP_ICMP=y
CONFIG_LWIP_IGMP=n
CONFIG_LWIP_SNMP=n
CONFIG_LWIP_DHCP=y
CONFIG_LWIP_DNS=n
CONFIG_LWIP_SOCKET=n
CONFIG_LWIP_DEBUG=n
CONFIG_APPHYPERVACCEPTANCE=y
CONFIG_APPHYPERVACCEPTANCE_HTTP_SERVICE=y
CONFIG_APPHYPERVACCEPTANCE_HTTP_PORT=8080
CONFIG_APPHYPERVACCEPTANCE_HTTP_DURATION_MS=360000
CONFIG_APPHYPERVACCEPTANCE_HTTP_MAX_CONNS=64
CONFIG_HZ=100
