{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "type": "string",
      "minLength": 6,
      "maxLength": 32
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "osDiskId": {
      "type": "string"
    },
    "imageSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "existingNicId": {
      "type": "string",
      "defaultValue": ""
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5",
      "allowedValues": [
        "Standard_D2s_v5",
        "Standard_D2as_v5",
        "Standard_B2s"
      ]
    }
  },
  "variables": {
    "vmName": "[concat(parameters('namePrefix'), '-vm')]",
    "vnetName": "[concat(parameters('namePrefix'), '-vnet')]",
    "nicName": "[concat(parameters('namePrefix'), '-nic')]",
    "nsgName": "[concat(parameters('namePrefix'), '-nsg')]",
    "tags": {
      "managed-by": "unikraft-hyperv",
      "unikraft-run": "[parameters('namePrefix')]",
      "image-sha256": "[parameters('imageSha256')]"
    }
  },
  "resources": [
    {
      "condition": "[empty(parameters('existingNicId'))]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "securityRules": []
      }
    },
    {
      "condition": "[empty(parameters('existingNicId'))]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.73.0.0/24"
          ]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "10.73.0.0/24",
              "defaultOutboundAccess": false,
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "condition": "[empty(parameters('existingNicId'))]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "enableAcceleratedNetworking": false,
        "enableIPForwarding": false,
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'default')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-11-01",
      "name": "[variables('vmName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "osDisk": {
            "name": "[last(split(parameters('osDiskId'), '/'))]",
            "osType": "Linux",
            "createOption": "Attach",
            "caching": "ReadOnly",
            "deleteOption": "Detach",
            "managedDisk": {
              "id": "[parameters('osDiskId')]"
            }
          }
        },
        "securityProfile": {
          "securityType": "Standard"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[if(empty(parameters('existingNicId')), resourceId('Microsoft.Network/networkInterfaces', variables('nicName')), parameters('existingNicId'))]",
              "properties": {
                "primary": true,
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    }
  ],
  "outputs": {
    "vmId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
    },
    "vmName": {
      "type": "string",
      "value": "[variables('vmName')]"
    }
  }
}
