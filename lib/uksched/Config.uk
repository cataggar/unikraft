menuconfig LIBUKSCHED
	bool "uksched: Abstraction for schedulers"
	default n
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKDEBUG
	select LIBUKALLOC
	select HAVE_SCHED
	select LIBUKLCPU
	select LIBUKPCPUVAR

if LIBUKSCHED

# Invisible symbol to enable TCB initialization
config LIBUKSCHED_TCB_INIT
	bool

config LIBUKSCHED_FIXED_SMP
	bool "Fixed per-LCPU scheduler ownership"
	default n
	depends on HAVE_SMP
	help
	  Enable immutable per-LCPU scheduler ownership, serialized queue
	  transitions, and checked remote wake delivery. This does not enable
	  migration or create secondary-CPU schedulers by itself.

config LIBUKSCHED_DEBUG
	bool "Enable debug messages"

config LIBUKSCHED_STATS
	bool "Scheduler statistics"
	depends on LIBUKSTORE # circular dependency
	help
		Provide scheduler stats via ukstore

endif
